@model IEnumerable<CinemaGestao2223226.Models.Reserva>

@{
    ViewData["Title"] = User.IsInRole("Administrador") ? "Todas as Reservas" : "As Minhas Reservas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .reservations-page {
        padding: 2rem 0;
    }
    
    .page-header {
        margin-bottom: 2rem;
    }
    
    .page-header h1 {
        color: #fff;
        font-size: 1.75rem;
        font-weight: 700;
    }
    
    .reservation-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }
    
    .reservation-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(56, 189, 248, 0.3);
        transform: translateY(-2px);
    }
    
    .reservation-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }
    
    .movie-title {
        color: #fff;
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
    }
    
    .reservation-id {
        color: var(--accent-cyan);
        font-size: 0.875rem;
        font-weight: 600;
    }
    
    .reservation-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
    }
    
    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .detail-label {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .detail-value {
        color: #fff;
        font-size: 0.95rem;
        font-weight: 500;
    }
    
    .detail-value.highlight {
        color: var(--accent-cyan);
        font-weight: 600;
    }
    
    .reservation-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .btn-details {
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: var(--accent-cyan);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-details:hover {
        background: rgba(56, 189, 248, 0.2);
        color: var(--accent-cyan);
    }
    
    .btn-cancel {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-cancel:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }
    
    .summary-card {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%);
        border: 1px solid rgba(56, 189, 248, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 2rem;
    }
    
    .summary-items {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
    }
    
    .summary-item {
        display: flex;
        flex-direction: column;
    }
    
    .summary-label {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .summary-value {
        color: var(--accent-cyan);
        font-size: 1.5rem;
        font-weight: 700;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }
    
    .empty-state i {
        font-size: 4rem;
        color: rgba(255, 255, 255, 0.2);
        margin-bottom: 1rem;
    }
    
    .empty-state h3 {
        color: #fff;
        margin-bottom: 0.5rem;
    }
    
    .empty-state p {
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 1.5rem;
    }
    
    .btn-explore {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, #0ea5e9 100%);
        border: none;
        color: #000;
        font-weight: 600;
        padding: 0.875rem 2rem;
        border-radius: 10px;
        transition: all 0.3s ease;
    }
    
    .btn-explore:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(56, 189, 248, 0.4);
        color: #000;
    }
</style>

<div class="container reservations-page">
    <div class="page-header">
        <h1>
            @if (User.IsInRole("Administrador"))
            {
                <i class="bi bi-ticket-detailed me-2"></i>@:Todas as Reservas
            }
            else
            {
                <i class="bi bi-ticket-perforated me-2"></i>@:As Minhas Reservas
            }
        </h1>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-ticket-perforated"></i>
            <h3>Sem reservas</h3>
            <p>Ainda não tem reservas registadas. Explore o nosso catálogo de filmes!</p>
            @if (User.IsInRole("Cliente"))
            {
                <a asp-controller="Catalogo" asp-action="Index" class="btn btn-explore">
                    <i class="bi bi-film me-2"></i> Explorar Filmes
                </a>
            }
        </div>
    }
    else
    {
        <div class="summary-card">
            <div class="summary-items">
                <div class="summary-item">
                    <span class="summary-label">Total Reservas</span>
                    <span class="summary-value">@Model.Count()</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Total Bilhetes</span>
                    <span class="summary-value">@Model.Sum(r => r.NumeroBilhetes)</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Valor Total</span>
                    <span class="summary-value">@Model.Sum(r => r.Sessao.Preco * r.NumeroBilhetes).ToString("C")</span>
                </div>
            </div>
        </div>

        @foreach (var reserva in Model.OrderByDescending(r => r.DataReserva))
        {
            <div class="reservation-card">
                <div class="reservation-header">
                    <h3 class="movie-title">@reserva.Sessao.Filme.Titulo</h3>
                    <span class="reservation-id">#@reserva.Id</span>
                </div>
                
                <div class="reservation-details">
                    <div class="detail-item">
                        <span class="detail-label">Data da Sessão</span>
                        <span class="detail-value">@reserva.Sessao.DataHora.ToString("dd MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Sala</span>
                        <span class="detail-value">@reserva.Sessao.Sala</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Bilhetes</span>
                        <span class="detail-value highlight">@reserva.NumeroBilhetes</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Total</span>
                        <span class="detail-value highlight">@((reserva.Sessao.Preco * reserva.NumeroBilhetes).ToString("C"))</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Reservado em</span>
                        <span class="detail-value">@reserva.DataReserva.ToString("dd/MM/yyyy")</span>
                    </div>
                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="detail-item">
                            <span class="detail-label">Cliente</span>
                            <span class="detail-value">@reserva.UtilizadorId.Substring(0, Math.Min(8, reserva.UtilizadorId.Length))...</span>
                        </div>
                    }
                </div>
                
                <div class="reservation-actions">
                    <a asp-action="Details" asp-route-id="@reserva.Id" class="btn btn-details">
                        <i class="bi bi-eye me-1"></i> Detalhes
                    </a>
                    <a asp-action="Delete" asp-route-id="@reserva.Id" class="btn btn-cancel">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                </div>
            </div>
        }
    }
</div>