@model IEnumerable<CinemaGestao2223226.Models.Filme>
@using CinemaGestao.Helpers

@{
    ViewData["Title"] = "Catálogo de Filmes";
}

<style>
    .catalog-hero {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(2, 6, 23, 0.95) 50%, rgba(15, 23, 42, 0.9) 100%);
        border-radius: 24px;
        padding: 3rem 2rem;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }

    .catalog-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 60%;
        height: 200%;
        background: radial-gradient(ellipse, rgba(56, 189, 248, 0.1) 0%, transparent 60%);
        pointer-events: none;
    }

    .catalog-hero h1 {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #ffffff 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
    }

    .catalog-hero .lead {
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }

    .catalog-stats {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .stat-item i {
        color: #38bdf8;
        font-size: 1.25rem;
    }

    .stat-item strong {
        color: #ffffff;
        font-weight: 700;
    }

    .filter-section {
        background: rgba(10, 10, 20, 0.6);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(56, 189, 248, 0.1);
    }

    .filter-section .form-label {
        color: rgba(255, 255, 255, 0.8);
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .filter-section .form-select,
    .filter-section .form-control {
        background: rgba(2, 6, 23, 0.8);
        border: 1px solid rgba(56, 189, 248, 0.2);
        color: #ffffff;
        border-radius: 10px;
        padding: 0.75rem 1rem;
    }

    .filter-section .form-select:focus,
    .filter-section .form-control:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
        background: rgba(2, 6, 23, 0.9);
        color: #ffffff;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
    }

    .movie-card-modern {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(2, 6, 23, 0.95) 100%);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(56, 189, 248, 0.1);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
    }

    .movie-card-modern:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: rgba(56, 189, 248, 0.4);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 40px rgba(56, 189, 248, 0.15);
    }

    .movie-poster-container {
        position: relative;
        width: 100%;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

    .movie-poster-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .movie-card-modern:hover .movie-poster-container img {
        transform: scale(1.1);
    }

    .poster-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to top, rgba(2, 6, 23, 1) 0%, rgba(2, 6, 23, 0.3) 50%, transparent 100%);
        opacity: 0.8;
        transition: opacity 0.4s ease;
    }

    .movie-card-modern:hover .poster-overlay {
        opacity: 0.6;
    }

    .badge-coming-soon {
        position: absolute;
        top: 15px;
        left: 15px;
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 20px rgba(249, 115, 22, 0.5);
        z-index: 10;
    }

    .badge-now-showing {
        position: absolute;
        top: 15px;
        left: 15px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 20px rgba(34, 197, 94, 0.5);
        z-index: 10;
    }

    .movie-rating {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(10px);
        color: #fbbf24;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        z-index: 10;
    }

    .movie-card-body {
        padding: 1.5rem;
        position: relative;
    }

    .movie-card-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.75rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .movie-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .movie-genre {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .movie-duration {
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .movie-description {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .movie-card-actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-view-details {
        flex: 1;
        background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
        color: #0f172a;
        border: none;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-view-details:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(56, 189, 248, 0.4);
        color: #0f172a;
    }

    .btn-quick-view {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.85rem 1rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-quick-view:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.4);
    }

    .no-movies-container {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(2, 6, 23, 0.95) 100%);
        border-radius: 24px;
        padding: 4rem 2rem;
        text-align: center;
        border: 1px solid rgba(56, 189, 248, 0.1);
    }

    .no-movies-container i {
        font-size: 4rem;
        color: rgba(56, 189, 248, 0.4);
        margin-bottom: 1.5rem;
    }

    .no-movies-container h3 {
        color: #ffffff;
        margin-bottom: 0.75rem;
    }

    .no-movies-container p {
        color: rgba(255, 255, 255, 0.6);
    }

    .placeholder-poster {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .placeholder-poster i {
        font-size: 4rem;
        color: rgba(56, 189, 248, 0.3);
    }

    @@media (max-width: 768px) {
        .catalog-hero {
            padding: 2rem 1.5rem;
        }

        .catalog-hero h1 {
            font-size: 1.75rem;
        }

        .catalog-stats {
            gap: 1rem;
        }

        .movie-grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.5rem;
        }
    }
</style>

<div class="container-fluid px-4 py-4 fade-in-up">
    <!-- Hero Section -->
    <div class="catalog-hero fade-in-down">
        <h1><i class="bi bi-film me-2"></i>Catálogo de Filmes</h1>
        <p class="lead">Descubra os melhores filmes em exibição e em breve no Nexor Cinema</p>
        <div class="catalog-stats">
            <div class="stat-item">
                <i class="bi bi-collection-play"></i>
                <span><strong>@Model.Count()</strong> Filmes Disponíveis</span>
            </div>
            <div class="stat-item">
                <i class="bi bi-star-fill"></i>
                <span><strong>@Model.Count(f => f.Status == CinemaGestao2223226.Models.StatusFilme.EmCartaz)</strong> Em Cartaz</span>
            </div>
            <div class="stat-item">
                <i class="bi bi-clock-history"></i>
                <span><strong>@Model.Count(f => f.Status == CinemaGestao2223226.Models.StatusFilme.Brevemente)</strong> Brevemente</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="no-movies-container scale-in">
            <i class="bi bi-film"></i>
            <h3>Nenhum Filme Disponível</h3>
            <p>Não existem filmes disponíveis no catálogo de momento. Volte mais tarde!</p>
        </div>
    }
    else
    {
        <!-- Filter Section -->
        <div class="filter-section fade-in-up stagger-delay-1">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-search me-1"></i>Pesquisar</label>
                    <input type="text" class="form-control" id="searchInput" placeholder="Pesquisar por título...">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-tag me-1"></i>Género</label>
                    <select class="form-select" id="genreFilter">
                        <option value="">Todos os Géneros</option>
                        @foreach (var genero in Model.Select(f => f.Genero).Distinct().OrderBy(g => g))
                        {
                            <option value="@genero">@genero</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-funnel me-1"></i>Estado</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">Todos</option>
                        <option value="EmCartaz">Em Cartaz</option>
                        <option value="Brevemente">Brevemente</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-light w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-1"></i>Limpar
                    </button>
                </div>
            </div>
        </div>

        <!-- Movie Grid -->
        <div class="movie-grid" id="movieGrid">
            @foreach (var filme in Model)
            {
                var index = Model.ToList().IndexOf(filme);
                var delay = (index % 4) * 0.1 + 0.1;
                
                <div class="movie-card-modern scale-in" 
                     data-title="@filme.Titulo.ToLower()" 
                     data-genre="@filme.Genero" 
                     data-status="@filme.Status"
                     style="animation-delay: @(delay)s">
                    <div class="movie-poster-container">
                        @if (!string.IsNullOrEmpty(filme.CapaUrl))
                        {
                            <img src="@filme.CapaUrl" alt="@filme.Titulo" loading="lazy">
                        }
                        else
                        {
                            <div class="placeholder-poster">
                                <i class="bi bi-film"></i>
                            </div>
                        }
                        <div class="poster-overlay"></div>
                        
                        @if (filme.Status == CinemaGestao2223226.Models.StatusFilme.Brevemente)
                        {
                            <span class="badge-coming-soon">
                                <i class="bi bi-clock-fill me-1"></i>Em Breve
                            </span>
                        }
                        else if (filme.Status == CinemaGestao2223226.Models.StatusFilme.EmCartaz)
                        {
                            <span class="badge-now-showing">
                                <i class="bi bi-play-circle-fill me-1"></i>Em Cartaz
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(filme.ClassificacaoEtaria))
                        {
                            <div class="movie-rating">
                                <i class="bi bi-person-badge"></i>
                                <span>@filme.ClassificacaoEtaria</span>
                            </div>
                        }
                    </div>
                    
                    <div class="movie-card-body">
                        <h3 class="movie-card-title">@filme.Titulo</h3>
                        
                        <div class="movie-meta">
                            <span class="movie-genre">@filme.Genero</span>
                            <span class="movie-duration">
                                <i class="bi bi-clock"></i>
                                @DurationHelper.FormatDuration(filme.DuracaoMinutos)
                            </span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(filme.Descricao))
                        {
                            <p class="movie-description">@filme.Descricao</p>
                        }
                        
                        <div class="movie-card-actions">
                            <a asp-action="Details" asp-route-id="@filme.Id" class="btn-view-details">
                                <i class="bi bi-info-circle"></i>
                                Ver Detalhes
                            </a>
                            @if (!string.IsNullOrEmpty(filme.TrailerUrl))
                            {
                                <a href="@filme.TrailerUrl" target="_blank" class="btn-quick-view" title="Ver Trailer">
                                    <i class="bi bi-play-fill"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const genreFilter = document.getElementById('genreFilter');
            const statusFilter = document.getElementById('statusFilter');
            const movieCards = document.querySelectorAll('.movie-card-modern');

            function filterMovies() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedGenre = genreFilter.value;
                const selectedStatus = statusFilter.value;

                movieCards.forEach(card => {
                    const title = card.dataset.title;
                    const genre = card.dataset.genre;
                    const status = card.dataset.status;

                    const matchesSearch = title.includes(searchTerm);
                    const matchesGenre = !selectedGenre || genre === selectedGenre;
                    const matchesStatus = !selectedStatus || status === selectedStatus;

                    if (matchesSearch && matchesGenre && matchesStatus) {
                        card.style.display = '';
                        card.style.animation = 'scaleIn 0.4s ease forwards';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            searchInput.addEventListener('input', filterMovies);
            genreFilter.addEventListener('change', filterMovies);
            statusFilter.addEventListener('change', filterMovies);

            console.log('Filtros do catálogo inicializados');
        });

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('genreFilter').value = '';
            document.getElementById('statusFilter').value = '';
            
            document.querySelectorAll('.movie-card-modern').forEach(card => {
                card.style.display = '';
            });
        }
    </script>
}