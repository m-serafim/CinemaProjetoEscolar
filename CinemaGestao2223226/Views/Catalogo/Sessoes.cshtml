@model IEnumerable<CinemaGestao2223226.Models.Sessao>

@{
    var filme = ViewBag.Filme as CinemaGestao2223226.Models.Filme;
    ViewData["Title"] = $"Sessões - {filme.Titulo}";
    
    // Group sessions by date
    var sessoesPorData = Model.GroupBy(s => s.DataHora.Date).OrderBy(g => g.Key);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .sessions-page {
        padding: 2rem 0;
    }
    
    .movie-header {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }
    
    .movie-header h1 {
        color: #fff;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .movie-header .lead {
        color: var(--accent-cyan);
        font-size: 1.1rem;
    }
    
    .date-section {
        margin-bottom: 2rem;
    }
    
    .date-header {
        background: linear-gradient(90deg, rgba(56, 189, 248, 0.2) 0%, transparent 100%);
        border-left: 4px solid var(--accent-cyan);
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        border-radius: 0 12px 12px 0;
    }
    
    .date-header h3 {
        color: #fff;
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .date-header h3 i {
        color: var(--accent-cyan);
    }
    
    .sessions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }
    
    .session-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.25rem;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }
    
    .session-card:hover {
        background: rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.3);
        transform: translateY(-2px);
    }
    
    .session-time {
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .session-time i {
        font-size: 1.5rem;
        color: var(--accent-cyan);
    }
    
    .session-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-grow: 1;
    }
    
    .session-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }
    
    .session-detail .label {
        color: rgba(255, 255, 255, 0.8);
    }
    
    .session-detail .value {
        color: #fff;
        font-weight: 500;
    }
    
    .session-detail .price {
        color: var(--accent-cyan);
        font-weight: 700;
        font-size: 1.1rem;
    }
    
    .seats-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }
    
    .seats-badge.available {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }
    
    .seats-badge.limited {
        background: rgba(234, 179, 8, 0.2);
        color: #eab308;
    }
    
    .seats-badge.sold-out {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }
    
    .btn-reserve {
        width: 100%;
        padding: 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }
    
    .btn-reserve.btn-primary {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, #0ea5e9 100%);
        border: none;
        color: #000;
    }
    
    .btn-reserve.btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(56, 189, 248, 0.4);
    }
    
    .btn-reserve.btn-outline-primary {
        background: transparent;
        border: 2px solid var(--accent-cyan);
        color: var(--accent-cyan);
    }
    
    .btn-reserve.btn-outline-primary:hover {
        background: rgba(56, 189, 248, 0.1);
    }
    
    .btn-reserve:disabled {
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.4);
        border: none;
        cursor: not-allowed;
    }
    
    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #fff;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    
    .back-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--accent-cyan);
    }
    
    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 1.5rem;
    }
    
    .breadcrumb-item a {
        color: var(--accent-cyan);
        text-decoration: none;
    }
    
    .breadcrumb-item a:hover {
        text-decoration: underline;
    }
    
    .breadcrumb-item.active {
        color: rgba(255, 255, 255, 0.9);
    }
    
    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255, 255, 255, 0.6);
    }
    
    .no-sessions-alert {
        background: rgba(234, 179, 8, 0.1);
        border: 1px solid rgba(234, 179, 8, 0.3);
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        color: #eab308;
    }
    
    .no-sessions-alert i {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        display: block;
    }
</style>

<div class="container sessions-page">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Catálogo</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@filme.Id">@filme.Titulo</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sessões</li>
        </ol>
    </nav>

    <div class="movie-header">
        <h1><i class="bi bi-film me-2"></i>@filme.Titulo</h1>
        <p class="lead"><i class="bi bi-ticket-perforated me-2"></i>Selecione uma sessão para reservar</p>
    </div>

    @if (!Model.Any())
    {
        <div class="no-sessions-alert">
            <i class="bi bi-exclamation-triangle"></i>
            <h4>Sem Sessões Disponíveis</h4>
            <p>Não existem sessões disponíveis para este filme de momento.</p>
        </div>
        <div class="mt-4">
            <a asp-action="Index" class="back-btn">
                <i class="bi bi-arrow-left"></i> Voltar ao Catálogo
            </a>
        </div>
    }
    else
    {
        @foreach (var grupo in sessoesPorData)
        {
            <div class="date-section">
                <div class="date-header">
                    <h3>
                        <i class="bi bi-calendar3"></i>
                        @grupo.Key.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("pt-PT"))
                    </h3>
                </div>
                
                <div class="sessions-grid">
                    @foreach (var sessao in grupo.OrderBy(s => s.DataHora))
                    {
                        <div class="session-card">
                            <div class="session-time">
                                <i class="bi bi-clock"></i>
                                @sessao.DataHora.ToString("HH:mm")
                            </div>
                            
                            <div class="session-info">
                                <div class="session-detail">
                                    <span class="label">Sala</span>
                                    <span class="value">@sessao.Sala</span>
                                </div>
                                <div class="session-detail">
                                    <span class="label">Preço</span>
                                    <span class="value price">@sessao.Preco.ToString("C")</span>
                                </div>
                                <div class="session-detail">
                                    <span class="label">Lugares</span>
                                    @if (sessao.LugaresDisponiveis > 10)
                                    {
                                        <span class="seats-badge available">
                                            <i class="bi bi-check-circle-fill"></i>
                                            @sessao.LugaresDisponiveis disponíveis
                                        </span>
                                    }
                                    else if (sessao.LugaresDisponiveis > 0)
                                    {
                                        <span class="seats-badge limited">
                                            <i class="bi bi-exclamation-circle-fill"></i>
                                            Últimos @sessao.LugaresDisponiveis
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="seats-badge sold-out">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Esgotado
                                        </span>
                                    }
                                </div>
                            </div>
                            
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                            {
                                @if (sessao.LugaresDisponiveis > 0)
                                {
                                    <a asp-controller="Reservas" asp-action="Create" asp-route-sessaoId="@sessao.Id" class="btn-reserve btn-primary">
                                        <i class="bi bi-ticket-perforated"></i> Reservar Bilhete
                                    </a>
                                }
                                else
                                {
                                    <button class="btn-reserve" disabled>
                                        <i class="bi bi-x-circle"></i> Esgotado
                                    </button>
                                }
                            }
                            else if (!User.Identity.IsAuthenticated)
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn-reserve btn-outline-primary">
                                    <i class="bi bi-box-arrow-in-right"></i> Entrar para Reservar
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        
        <div class="mt-4">
            <a asp-action="Details" asp-route-id="@filme.Id" class="back-btn">
                <i class="bi bi-arrow-left"></i> Voltar aos Detalhes
            </a>
        </div>
    }
</div>