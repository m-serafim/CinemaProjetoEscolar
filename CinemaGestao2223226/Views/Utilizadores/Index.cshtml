@model IEnumerable<(Microsoft.AspNetCore.Identity.IdentityUser User, string Role)>

@{
    ViewData["Title"] = "Utilizadores";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .admin-page {
        padding: 2rem 0;
    }
    
    .admin-header {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }
    
    .admin-header h1 {
        color: #fff;
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0;
    }
    
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
    }
    
    .stat-card.admins {
        border-color: rgba(239, 68, 68, 0.3);
        background: rgba(239, 68, 68, 0.05);
    }
    
    .stat-card.clients {
        border-color: rgba(59, 130, 246, 0.3);
        background: rgba(59, 130, 246, 0.05);
    }
    
    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent-cyan);
    }
    
    .stat-card.admins .stat-value {
        color: #ef4444;
    }
    
    .stat-card.clients .stat-value {
        color: #3b82f6;
    }
    
    .stat-label {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .users-grid {
        display: grid;
        gap: 1rem;
    }
    
    .user-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }
    
    .user-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(56, 189, 248, 0.3);
    }
    
    .user-card.admin-user {
        border-left: 4px solid #ef4444;
    }
    
    .user-card.client-user {
        border-left: 4px solid #3b82f6;
    }
    
    .user-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .user-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 700;
        color: #fff;
    }
    
    .user-avatar.admin {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }
    
    .user-avatar.client {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
    }
    
    .user-details h3 {
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        margin: 0 0 0.25rem 0;
    }
    
    .user-details p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.875rem;
        margin: 0;
    }
    
    .user-badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    
    .badge-role {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .badge-admin {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }
    
    .badge-cliente {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }
    
    .badge-verified {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    
    .badge-unverified {
        background: rgba(234, 179, 8, 0.15);
        color: #eab308;
        border: 1px solid rgba(234, 179, 8, 0.3);
    }
    
    .badge-active {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }
    
    .badge-blocked {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }
    
    .user-actions {
        display: flex;
        gap: 0.5rem;
    }
    
    .btn-delete {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px dashed rgba(255, 255, 255, 0.2);
    }
    
    .empty-state i {
        font-size: 4rem;
        color: rgba(255, 255, 255, 0.3);
    }
</style>

<div class="container admin-page">
    <div class="admin-header">
        <h1><i class="bi bi-people-fill me-2"></i>Gestão de Utilizadores</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <h3>Sem Utilizadores</h3>
            <p>Não existem utilizadores registados no sistema.</p>
        </div>
    }
    else
    {
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">Total Utilizadores</div>
            </div>
            <div class="stat-card admins">
                <div class="stat-value">@Model.Count(u => u.Role == "Administrador")</div>
                <div class="stat-label">Administradores</div>
            </div>
            <div class="stat-card clients">
                <div class="stat-value">@Model.Count(u => u.Role == "Cliente")</div>
                <div class="stat-label">Clientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@Model.Count(u => u.User.EmailConfirmed)</div>
                <div class="stat-label">Emails Verificados</div>
            </div>
        </div>

        <div class="users-grid">
            @foreach (var item in Model.OrderBy(u => u.User.Email))
            {
                var isAdmin = item.Role == "Administrador";
                var initials = item.User.Email?.Length > 0 ? item.User.Email.Substring(0, 1).ToUpper() : "?";
                
                <div class="user-card @(isAdmin ? "admin-user" : "client-user")">
                    <div class="user-info">
                        <div class="user-avatar @(isAdmin ? "admin" : "client")">
                            @initials
                        </div>
                        <div class="user-details">
                            <h3>@item.User.Email</h3>
                            <p><i class="bi bi-person me-1"></i>@item.User.UserName</p>
                        </div>
                    </div>
                    
                    <div class="user-badges">
                        @if (isAdmin)
                        {
                            <span class="badge-role badge-admin">
                                <i class="bi bi-shield-fill-check"></i> Administrador
                            </span>
                        }
                        else
                        {
                            <span class="badge-role badge-cliente">
                                <i class="bi bi-person-fill"></i> Cliente
                            </span>
                        }
                        
                        @if (item.User.EmailConfirmed)
                        {
                            <span class="badge-role badge-verified">
                                <i class="bi bi-check-circle-fill"></i> Verificado
                            </span>
                        }
                        else
                        {
                            <span class="badge-role badge-unverified">
                                <i class="bi bi-exclamation-circle-fill"></i> Não Verificado
                            </span>
                        }
                        
                        @if (item.User.LockoutEnd.HasValue && item.User.LockoutEnd > DateTimeOffset.Now)
                        {
                            <span class="badge-role badge-blocked">
                                <i class="bi bi-lock-fill"></i> Bloqueado
                            </span>
                        }
                        else
                        {
                            <span class="badge-role badge-active">
                                <i class="bi bi-unlock-fill"></i> Ativo
                            </span>
                        }
                    </div>
                    
                    <div class="user-actions">
                        <a asp-action="Delete" asp-route-id="@item.User.Id" class="btn btn-danger btn-delete">
                            <i class="bi bi-trash-fill"></i> Eliminar
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>