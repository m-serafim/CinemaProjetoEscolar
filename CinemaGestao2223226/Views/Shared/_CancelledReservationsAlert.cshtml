@using System.Security.Claims
@inject CinemaGestao2223226.Data.ApplicationDbContext DbContext

@if (User.Identity?.IsAuthenticated == true)
{
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    if (!string.IsNullOrEmpty(userId))
    {
        var reservasCanceladas = DbContext.Reservas
            .Where(r => r.UtilizadorId == userId && r.CanceladaPeloSistema && !r.AvisoVisualizado)
            .ToList();

        if (reservasCanceladas.Any())
        {
            <div class="cancelled-reservations-overlay" id="cancelledReservationsOverlay">
                <div class="cancelled-reservations-modal">
                    <div class="modal-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h2>Aviso Importante</h2>
                    <p class="modal-subtitle">As seguintes reservas foram canceladas</p>
                    
                    <div class="cancelled-list">
                        @foreach (var reserva in reservasCanceladas)
                        {
                            <div class="cancelled-item">
                                <div class="cancelled-info">
                                    <i class="bi bi-ticket-perforated"></i>
                                    <div>
                                        <strong>Reserva #@reserva.Id</strong>
                                        <p>@reserva.MotivoCancelamento</p>
                                        <p class="cancelled-details">
                                            @reserva.NumeroBilhetes bilhete(s) • Lugares: @(reserva.LugaresSelecionados ?? "N/A")
                                        </p>
                                    </div>
                                </div>
                                <div class="refund-status">
                                    @if (reserva.Reembolsado)
                                    {
                                        <span class="refund-badge refunded">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Reembolsado: @reserva.ValorPago.ToString("C")
                                        </span>
                                        <small>Data: @reserva.DataReembolso?.ToString("dd/MM/yyyy HH:mm")</small>
                                        @if (!string.IsNullOrEmpty(reserva.NumeroCartao))
                                        {
                                            <small>Cartão: **** **** **** @reserva.NumeroCartao.Substring(Math.Max(0, reserva.NumeroCartao.Length - 4))</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="refund-badge pending">
                                            <i class="bi bi-clock-fill"></i>
                                            Reembolso Pendente
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="modal-message">
                        <i class="bi bi-info-circle"></i>
                        <p>O valor dos seus bilhetes será reembolsado automaticamente para o cartão utilizado na compra. O reembolso será processado dentro de 5-10 dias úteis.</p>
                    </div>
                    
                    <div class="refund-guarantee">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <strong>Garantia de Reembolso</strong>
                            <p>O Nexor Cinema garante o reembolso total do valor pago para o método de pagamento original.</p>
                        </div>
                    </div>
                    
                    <form method="post" asp-controller="Reservas" asp-action="MarkAlertsAsViewed">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-acknowledge">
                            <i class="bi bi-check-lg"></i>
                            Entendido
                        </button>
                    </form>
                </div>
            </div>

            <style>
                .cancelled-reservations-overlay {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.85);
                    backdrop-filter: blur(10px);
                    z-index: 9999;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 1rem;
                    animation: fadeIn 0.3s ease;
                }

                @@keyframes fadeIn {
                    from { opacity: 0; }
                    to { opacity: 1; }
                }

                .cancelled-reservations-modal {
                    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
                    border: 2px solid #dc3545;
                    border-radius: 20px;
                    padding: 2.5rem;
                    max-width: 600px;
                    width: 100%;
                    max-height: 90vh;
                    overflow-y: auto;
                    box-shadow: 0 25px 80px rgba(220, 53, 69, 0.3);
                    animation: slideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                }

                @@keyframes slideIn {
                    from { 
                        opacity: 0; 
                        transform: scale(0.9) translateY(-20px); 
                    }
                    to { 
                        opacity: 1; 
                        transform: scale(1) translateY(0); 
                    }
                }

                .modal-icon {
                    text-align: center;
                    margin-bottom: 1.5rem;
                }

                .modal-icon i {
                    font-size: 4rem;
                    color: #dc3545;
                    animation: pulse 2s infinite;
                }

                @@keyframes pulse {
                    0%, 100% { transform: scale(1); }
                    50% { transform: scale(1.1); }
                }

                .cancelled-reservations-modal h2 {
                    color: #ffffff;
                    text-align: center;
                    font-size: 1.75rem;
                    margin-bottom: 0.5rem;
                }

                .modal-subtitle {
                    color: #9ca3af;
                    text-align: center;
                    margin-bottom: 1.5rem;
                }

                .cancelled-list {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                    margin-bottom: 1.5rem;
                }

                .cancelled-item {
                    background: rgba(220, 53, 69, 0.1);
                    border: 1px solid rgba(220, 53, 69, 0.3);
                    border-radius: 12px;
                    padding: 1.25rem;
                }

                .cancelled-info {
                    display: flex;
                    gap: 1rem;
                    align-items: flex-start;
                    margin-bottom: 1rem;
                }

                .cancelled-info > i {
                    font-size: 1.5rem;
                    color: #dc3545;
                    margin-top: 0.25rem;
                }

                .cancelled-info strong {
                    color: #ffffff;
                    display: block;
                    margin-bottom: 0.25rem;
                }

                .cancelled-info p {
                    color: #9ca3af;
                    font-size: 0.9rem;
                    margin: 0;
                }

                .cancelled-details {
                    color: #6b7280 !important;
                    font-size: 0.85rem !important;
                    margin-top: 0.5rem !important;
                }

                .refund-status {
                    display: flex;
                    flex-direction: column;
                    gap: 0.25rem;
                    padding-left: 2.5rem;
                }

                .refund-status small {
                    color: #6b7280;
                    font-size: 0.8rem;
                }

                .refund-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                    padding: 0.5rem 1rem;
                    border-radius: 20px;
                    font-size: 0.9rem;
                    font-weight: 600;
                    width: fit-content;
                }

                .refund-badge.refunded {
                    background: rgba(34, 197, 94, 0.2);
                    color: #22c55e;
                    border: 1px solid rgba(34, 197, 94, 0.4);
                }

                .refund-badge.pending {
                    background: rgba(234, 179, 8, 0.2);
                    color: #eab308;
                    border: 1px solid rgba(234, 179, 8, 0.4);
                }

                .modal-message {
                    display: flex;
                    gap: 0.75rem;
                    align-items: flex-start;
                    background: rgba(56, 189, 248, 0.1);
                    border: 1px solid rgba(56, 189, 248, 0.3);
                    border-radius: 12px;
                    padding: 1rem;
                    margin-bottom: 1.5rem;
                }

                .modal-message i {
                    color: #38bdf8;
                    font-size: 1.25rem;
                    margin-top: 0.1rem;
                }

                .modal-message p {
                    color: #9ca3af;
                    font-size: 0.9rem;
                    margin: 0;
                }

                .refund-guarantee {
                    display: flex;
                    gap: 1rem;
                    align-items: flex-start;
                    background: rgba(34, 197, 94, 0.1);
                    border: 1px solid rgba(34, 197, 94, 0.3);
                    border-radius: 12px;
                    padding: 1rem;
                    margin-bottom: 1.5rem;
                }

                .refund-guarantee > i {
                    color: #22c55e;
                    font-size: 2rem;
                    margin-top: 0.1rem;
                }

                .refund-guarantee strong {
                    color: #22c55e;
                    display: block;
                    margin-bottom: 0.25rem;
                }

                .refund-guarantee p {
                    color: #9ca3af;
                    font-size: 0.85rem;
                    margin: 0;
                }

                .btn-acknowledge {
                    width: 100%;
                    background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
                    color: #0f172a;
                    border: none;
                    padding: 1rem 2rem;
                    border-radius: 50px;
                    font-weight: 700;
                    font-size: 1.1rem;
                    cursor: pointer;
                    transition: all 0.3s ease;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 0.5rem;
                }

                .btn-acknowledge:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 30px rgba(56, 189, 248, 0.4);
                }
            </style>
        }
    }
}
