<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <!-- Desktop: Two-column layout - Everything left, Search right -->
        <div class="container-fluid d-none d-lg-flex header-desktop-flex">
            <!-- Left: Logo + Nav Links + User Actions -->
            <div class="navbar-left-section">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/nexor-icon.ico" alt="Nexor Cinema" class="logo-icon" />
                    <span class="logo-text">Nexor Cinema</span>
                </a>

                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                }

                <ul class="navbar-nav d-flex flex-row">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Catalogo" ? "active nav-link-highlighted" : "")" asp-controller="Catalogo" asp-action="Index">
                            <i class="bi bi-film"></i> Catálogo de Filmes
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Reservas" ? "active" : "")" asp-controller="Reservas" asp-action="Index">As Minhas Reservas</a>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                    {
                        var isAdminPage = currentController == "Filmes" || currentController == "Sessoes" || currentController == "Utilizadores";
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isAdminPage ? "active" : "")" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-fill-check"></i> Administração
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item @(currentController == "Filmes" ? "active" : "")" asp-controller="Filmes" asp-action="Index"><i class="bi bi-film"></i> Gerir Filmes</a></li>
                                <li><a class="dropdown-item @(currentController == "Sessoes" ? "active" : "")" asp-controller="Sessoes" asp-action="Index"><i class="bi bi-calendar-event"></i> Gerir Sessões</a></li>
                                <li><a class="dropdown-item @(currentController == "Utilizadores" ? "active" : "")" asp-controller="Utilizadores" asp-action="Index"><i class="bi bi-people"></i> Gerir Utilizadores</a></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                                <li><a class="dropdown-item @(currentController == "Reservas" && currentAction == "Profits" ? "active" : "")" asp-controller="Reservas" asp-action="Profits"><i class="bi bi-graph-up-arrow"></i> Lucros e Estatísticas</a></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                                <li><a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#resetAllModalHeader"><i class="bi bi-exclamation-triangle"></i> Reset Total</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <div class="navbar-user-section">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <partial name="_LoginPartial" />
                    }
                    else
                    {
                        <a class="action-btn btn-login" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Right: Search Box -->
            <div class="navbar-right-section">
                <div class="search-box" role="search">
                    <img src="~/images/icons/search.svg" alt="Pesquisar" class="search-icon" aria-hidden="true" />
                    <input type="text" id="liveSearchInput" class="search-input" placeholder="Pesquisar filmes..." 
                           autocomplete="off" aria-label="Pesquisar filmes" aria-describedby="searchResults" />
                    <button type="button" id="clearSearchBtn" class="search-clear-btn" aria-label="Limpar pesquisa" style="display: none;">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                    <div id="searchResults" class="search-results" style="display: none;" role="listbox" aria-live="polite"></div>
                </div>
            </div>
        </div>

        <!-- Mobile: Collapsible layout -->
        <div class="container-fluid d-lg-none d-flex justify-content-between align-items-center flex-wrap">
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/nexor-icon.ico" alt="Nexor Cinema" class="logo-icon" />
                <span class="logo-text">Nexor Cinema</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse w-100" id="navbarContent">
                <ul class="navbar-nav mb-3 mt-3">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Catalogo" ? "active nav-link-highlighted" : "")" asp-controller="Catalogo" asp-action="Index">
                            <i class="bi bi-film"></i> Catálogo de Filmes
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Reservas" ? "active" : "")" asp-controller="Reservas" asp-action="Index">As Minhas Reservas</a>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Filmes" ? "active" : "")" asp-controller="Filmes" asp-action="Index">
                                <i class="bi bi-film"></i> Gerir Filmes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Sessoes" ? "active" : "")" asp-controller="Sessoes" asp-action="Index">
                                <i class="bi bi-calendar-event"></i> Gerir Sessões
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Utilizadores" ? "active" : "")" asp-controller="Utilizadores" asp-action="Index">
                                <i class="bi bi-people"></i> Gerir Utilizadores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Reservas" && ViewContext.RouteData.Values["action"]?.ToString() == "Profits" ? "active" : "")" asp-controller="Reservas" asp-action="Profits">
                                <i class="bi bi-graph-up-arrow"></i> Lucros e Estatísticas
                            </a>
                        </li>
                    }
                </ul>

                <div class="mb-3">
                    <div class="search-box" role="search">
                        <img src="~/images/icons/search.svg" alt="Pesquisar" class="search-icon" aria-hidden="true" />
                        <input type="text" id="liveSearchInputMobile" class="search-input" placeholder="Pesquisar filmes..." 
                               autocomplete="off" aria-label="Pesquisar filmes" />
                        <button type="button" id="clearSearchBtnMobile" class="search-clear-btn" aria-label="Limpar pesquisa" style="display: none;">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>
                </div>

                <div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <partial name="_LoginPartial" />
                    }
                    else
                    {
                        <a class="action-btn btn-login" asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<!-- Modal Reset Total (Global - Disponível no Header) -->
@if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
{
    <div class="modal fade" id="resetAllModalHeader" tabindex="-1" aria-labelledby="resetAllModalHeaderLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 2px solid #dc3545;">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger" id="resetAllModalHeaderLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Reset Total do Sistema
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-white">
                    <div class="alert alert-danger">
                        <strong><i class="bi bi-exclamation-octagon me-2"></i>ATENÇÃO!</strong>
                        <p class="mb-0 mt-2">Esta ação irá eliminar permanentemente:</p>
                        <ul class="mb-0 mt-2">
                            <li>Todos os filmes</li>
                            <li>Todas as sessões</li>
                            <li>Todas as reservas (incluindo transações, reembolsos e histórico)</li>
                            <li>Todos os lucros e estatísticas do administrador</li>
                        </ul>
                        <p class="mb-0 mt-2"><strong>Serão mantidas:</strong></p>
                        <ul class="mb-0 mt-1">
                            <li>As contas de utilizador (administradores e clientes)</li>
                        </ul>
                    </div>
                    <p class="text-muted">Esta ação é <strong>irreversível</strong>. Todos os dados serão apagados definitivamente e não podem ser recuperados.</p>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="confirmResetHeader">
                        <label class="form-check-label text-warning" for="confirmResetHeader">
                            Eu compreendo e quero proceder com o reset total
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-controller="Sessoes" asp-action="ResetAll" method="post" id="resetAllFormHeader">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" id="btnConfirmResetHeader" disabled>
                            <i class="bi bi-trash"></i> Eliminar Tudo
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var confirmCheckbox = document.getElementById('confirmResetHeader');
            var confirmBtn = document.getElementById('btnConfirmResetHeader');
            if (confirmCheckbox && confirmBtn) {
                confirmCheckbox.addEventListener('change', function() {
                    confirmBtn.disabled = !this.checked;
                });
            }
        });
    </script>
}
