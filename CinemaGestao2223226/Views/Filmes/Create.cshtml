@model CinemaGestao2223226.Models.Filme

@{
    ViewData["Title"] = "Adicionar Filme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container fade-in-up">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4 fade-in-down"><i class="bi bi-plus-circle"></i> Adicionar Novo Filme</h1>

            <!-- Movie Search Section -->
            <div class="card shadow mb-4 scale-in">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-search"></i> Pesquisar Filme no IMDb
                    </h5>
                    <div class="input-group mb-3">
                        <input type="text" id="movieSearchInput" class="form-control form-control-lg" 
                               placeholder="Introduza o título do filme (ex: Inception, The Matrix)..." />
                        <button class="btn btn-primary btn-lg" type="button" id="searchButton">
                            <i class="bi bi-search"></i> Pesquisar
                        </button>
                    </div>
                    
                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" class="text-center my-4" style="display: none;">
                        <div class="loading-spinner loading-spinner-lg"></div>
                        <p class="mt-2 fade-in">A pesquisar filmes...</p>
                    </div>

                    <!-- Search Results -->
                    <div id="movieSearchResults" class="row g-3"></div>

                    <!-- Error Message -->
                    <div id="searchError" class="alert alert-danger" role="alert" style="display: none;"></div>
                </div>
            </div>

            <!-- Manual Entry Form -->
            <div class="card shadow scale-in stagger-delay-2">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-pencil"></i> Detalhes do Filme
                        <small class="text-muted">(Preenchido automaticamente ou manualmente)</small>
                    </h5>
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shake" role="alert"></div>
                        
                        <div class="mb-3 form-group-animated">
                            <label asp-for="Titulo" class="form-label">
                                <i class="bi bi-file-text"></i> <strong>Título</strong>
                            </label>
                            <input asp-for="Titulo" class="form-control form-control-lg" placeholder="Ex: O Senhor dos Anéis" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="Genero" class="form-label">
                                    <i class="bi bi-tag"></i> <strong>Género</strong>
                                </label>
                                <input asp-for="Genero" class="form-control" placeholder="Ex: Ação, Aventura" />
                                <span asp-validation-for="Genero" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="DuracaoMinutos" class="form-label">
                                    <i class="bi bi-clock"></i> <strong>Duração (minutos)</strong>
                                </label>
                                <input asp-for="DuracaoMinutos" type="number" class="form-control" placeholder="Ex: 120" />
                                <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-group-animated">
                            <label asp-for="Descricao" class="form-label">
                                <i class="bi bi-card-text"></i> <strong>Descrição</strong>
                            </label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva o filme..."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>

                        <div class="mb-4 form-group-animated">
                            <label asp-for="CapaUrl" class="form-label">
                                <i class="bi bi-image"></i> <strong>URL da Capa (Poster)</strong>
                            </label>
                            <input asp-for="CapaUrl" class="form-control mb-2" placeholder="https://exemplo.com/capa.jpg" id="capaUrlInput" />
                            <span asp-validation-for="CapaUrl" class="text-danger"></span>
                            <div class="d-flex gap-2 align-items-center mt-2">
                                <small class="form-text text-muted flex-grow-1">
                                    <i class="bi bi-info-circle"></i> Imagem vertical para listagens (poster do filme)
                                </small>
                                <a href="https://www.themoviedb.org/movie" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info">
                                    <i class="bi bi-search"></i> Procurar Capas (TMDb)
                                </a>
                                <a href="https://www.imdb.com/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning">
                                    <i class="bi bi-search"></i> Procurar no IMDb
                                </a>
                            </div>
                            <div id="imagePreview" class="mt-3" style="display: none;">
                                <small class="text-muted">Pré-visualização:</small><br>
                                <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-width: 200px; max-height: 300px;">
                            </div>
                        </div>

                        <div class="mb-4 form-group-animated">
                            <label asp-for="BannerUrl" class="form-label">
                                <i class="bi bi-image-fill"></i> <strong>URL do Banner (Hero)</strong>
                            </label>
                            <input asp-for="BannerUrl" class="form-control mb-2" placeholder="https://exemplo.com/banner.jpg" id="bannerUrlInput" />
                            <span asp-validation-for="BannerUrl" class="text-danger"></span>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i> Imagem horizontal/wide para o destaque na homepage (1920x1080 recomendado)
                            </small>
                            <div id="bannerPreview" class="mt-3" style="display: none;">
                                <small class="text-muted">Pré-visualização Banner:</small><br>
                                <img id="previewBannerImg" src="" alt="Preview Banner" class="img-thumbnail" style="max-width: 400px; max-height: 200px;">
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h5 class="mb-3"><i class="bi bi-info-circle"></i> Informações Adicionais (Opcional)</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="Elenco" class="form-label">
                                    <i class="bi bi-people"></i> <strong>Elenco</strong>
                                </label>
                                <input asp-for="Elenco" class="form-control" placeholder="Ex: Jack Black, Paul Rudd, Steve Zahn" />
                                <span asp-validation-for="Elenco" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="Realizador" class="form-label">
                                    <i class="bi bi-camera-reels"></i> <strong>Realizador</strong>
                                </label>
                                <input asp-for="Realizador" class="form-control" placeholder="Ex: Tom Gormican" />
                                <span asp-validation-for="Realizador" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="DataEstreia" class="form-label">
                                    <i class="bi bi-calendar-event"></i> <strong>Data de Estreia</strong>
                                </label>
                                <input asp-for="DataEstreia" type="date" class="form-control" />
                                <span asp-validation-for="DataEstreia" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3 form-group-animated">
                                <label asp-for="TrailerUrl" class="form-label">
                                    <i class="bi bi-play-btn"></i> <strong>URL do Trailer</strong>
                                </label>
                                <input asp-for="TrailerUrl" class="form-control" placeholder="https://youtube.com/watch?v=..." />
                                <span asp-validation-for="TrailerUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label">
                                    <i class="bi bi-tag-fill"></i> <strong>Status do Filme</strong>
                                </label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CinemaGestao2223226.Models.StatusFilme>()">
                                </select>
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> "Em Cartaz" - O filme pode ter sessões criadas. "Brevemente" - O filme aparece apenas na secção "Em Breve"
                                </small>
                            </div>
                        </div>

                        <div class="mb-4 form-group-animated">
                            <div class="form-check form-switch">
                                <input asp-for="DestaqueHome" class="form-check-input" type="checkbox" id="destaqueHomeCheck" />
                                <label asp-for="DestaqueHome" class="form-check-label">
                                    <i class="bi bi-star-fill text-warning"></i> <strong>Destaque na Homepage</strong>
                                    <small class="text-muted d-block">Marque para exibir este filme no banner principal da homepage</small>
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 form-group-animated">
                            <button type="submit" class="btn btn-success btn-lg btn-ripple hover-lift">
                                <i class="bi bi-check-circle"></i> Guardar Filme
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Elements
        const searchInput = document.getElementById('movieSearchInput');
        const searchButton = document.getElementById('searchButton');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const searchResults = document.getElementById('movieSearchResults');
        const searchError = document.getElementById('searchError');
        const capaUrlInput = document.getElementById('capaUrlInput');
        const imagePreview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        const bannerUrlInput = document.getElementById('bannerUrlInput');
        const bannerPreview = document.getElementById('bannerPreview');
        const previewBannerImg = document.getElementById('previewBannerImg');

        // Image preview functionality for Cover
        capaUrlInput.addEventListener('input', function() {
            const url = this.value.trim();
            if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
                previewImg.src = url;
                imagePreview.style.display = 'block';
                
                // Hide preview if image fails to load
                previewImg.onerror = function() {
                    imagePreview.style.display = 'none';
                };
            } else {
                imagePreview.style.display = 'none';
            }
        });

        // Image preview functionality for Banner
        bannerUrlInput.addEventListener('input', function() {
            const url = this.value.trim();
            if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
                previewBannerImg.src = url;
                bannerPreview.style.display = 'block';
                
                previewBannerImg.onerror = function() {
                    bannerPreview.style.display = 'none';
                };
            } else {
                bannerPreview.style.display = 'none';
            }
        });

        // Movie search functionality
        searchButton.addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        async function performSearch() {
            const query = searchInput.value.trim();
            if (!query) {
                showError('Please enter a movie title to search');
                return;
            }

            // Show loading, hide results and errors
            loadingSpinner.style.display = 'block';
            searchResults.innerHTML = '';
            searchError.style.display = 'none';

            try {
                const response = await fetch(`/Filmes/SearchMovies?query=${encodeURIComponent(query)}`, {
                    credentials: 'include'
                });
                const data = await response.json();

                loadingSpinner.style.display = 'none';

                if (!data.success) {
                    showError(data.error || 'No movies found');
                    return;
                }

                displayResults(data.movies);
            } catch (error) {
                loadingSpinner.style.display = 'none';
                showError('Error connecting to the server. Please try again.');
                console.error('Search error:', error);
            }
        }

        function displayResults(movies) {
            if (!movies || movies.length === 0) {
                showError('No movies found');
                return;
            }

            searchResults.innerHTML = '';
            
            movies.forEach(movie => {
                const col = document.createElement('div');
                col.className = 'col-md-3';
                
                const card = document.createElement('div');
                card.className = 'card h-100 shadow-sm movie-card';
                card.style.cursor = 'pointer';
                card.onclick = () => selectMovie(movie.imdbID);
                
                const posterUrl = movie.poster && movie.poster !== 'N/A' 
                    ? movie.poster 
                    : 'https://via.placeholder.com/300x450?text=No+Poster';
                
                card.innerHTML = `
                    <img src="${posterUrl}" class="card-img-top" alt="${movie.title}" 
                         style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title">${movie.title}</h6>
                        <p class="card-text text-muted small">
                            <i class="bi bi-calendar"></i> ${movie.year}
                        </p>
                        <button class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-check-circle"></i> Select
                        </button>
                    </div>
                `;
                
                col.appendChild(card);
                searchResults.appendChild(col);
            });
        }

        async function selectMovie(imdbId) {
            // Show loading
            loadingSpinner.style.display = 'block';
            searchResults.innerHTML = '';
            searchError.style.display = 'none';

            try {
                const response = await fetch(`/Filmes/GetMovieDetails?imdbId=${imdbId}`, {
                    credentials: 'include'
                });
                const data = await response.json();

                loadingSpinner.style.display = 'none';

                if (!data.success) {
                    showError(data.error || 'Error loading movie details. Please try again.');
                    return;
                }

                // Auto-fill form fields
                const movie = data.movie;
                document.querySelector('input[name="Titulo"]').value = movie.titulo || '';
                document.querySelector('input[name="Genero"]').value = movie.genero || '';
                document.querySelector('input[name="DuracaoMinutos"]').value = movie.duracaoMinutos || '';
                document.querySelector('textarea[name="Descricao"]').value = movie.descricao || '';
                capaUrlInput.value = movie.capaUrl || '';
                
                // Fill additional fields from TMDB
                if (movie.bannerUrl) {
                    bannerUrlInput.value = movie.bannerUrl;
                    bannerUrlInput.dispatchEvent(new Event('input'));
                }
                
                const elencoInput = document.querySelector('input[name="Elenco"]');
                if (elencoInput && movie.elenco) {
                    elencoInput.value = movie.elenco;
                }
                
                const realizadorInput = document.querySelector('input[name="Realizador"]');
                if (realizadorInput && movie.realizador) {
                    realizadorInput.value = movie.realizador;
                }
                
                const classificacaoInput = document.querySelector('input[name="ClassificacaoEtaria"]');
                if (classificacaoInput && movie.classificacaoEtaria) {
                    classificacaoInput.value = movie.classificacaoEtaria;
                }

                // Trigger image preview
                capaUrlInput.dispatchEvent(new Event('input'));

                // Show success message
                showSuccess('Movie details loaded successfully! Review and save.');

                // Scroll to form
                document.querySelector('input[name="Titulo"]').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch (error) {
                loadingSpinner.style.display = 'none';
                showError('Error loading movie details. Please try again.');
                console.error('Details error:', error);
            }
        }

        function showError(message) {
            searchError.textContent = message;
            searchError.style.display = 'block';
        }

        function showSuccess(message) {
            searchError.className = 'alert alert-success';
            searchError.textContent = message;
            searchError.style.display = 'block';
            
            // Reset to error class after 5 seconds
            setTimeout(() => {
                searchError.className = 'alert alert-danger';
                searchError.style.display = 'none';
            }, 5000);
        }
    </script>
    
    <style>
        .movie-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
        }
    </style>
}

