@model CinemaGestao.Models.Filme

@{
    ViewData["Title"] = "Adicionar Movie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4"><i class="bi bi-plus-circle"></i> Add New Movie</h1>

            <!-- Movie Search Section -->
            <div class="card shadow mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-search"></i> Search Movie from IMDb
                    </h5>
                    <div class="input-group mb-3">
                        <input type="text" id="movieSearchInput" class="form-control form-control-lg" 
                               placeholder="Enter movie title (e.g., Inception, The Matrix)..." />
                        <button class="btn btn-primary btn-lg" type="button" id="searchButton">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    
                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" class="text-center my-4" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Searching movies...</p>
                    </div>

                    <!-- Search Results -->
                    <div id="movieSearchResults" class="row g-3"></div>

                    <!-- Error Message -->
                    <div id="searchError" class="alert alert-danger" role="alert" style="display: none;"></div>
                </div>
            </div>

            <!-- Manual Entry Form -->
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-pencil"></i> Movie Details
                        <small class="text-muted">(Auto-filled or enter manually)</small>
                    </h5>
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label">
                                <i class="bi bi-file-text"></i> <strong>Title</strong>
                            </label>
                            <input asp-for="Titulo" class="form-control form-control-lg" placeholder="Ex: O Senhor dos Anéis" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Genero" class="form-label">
                                    <i class="bi bi-tag"></i> <strong>Genre</strong>
                                </label>
                                <input asp-for="Genero" class="form-control" placeholder="Ex: Ação, Aventura" />
                                <span asp-validation-for="Genero" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DuracaoMinutos" class="form-label">
                                    <i class="bi bi-clock"></i> <strong>Duration (minutes)</strong>
                                </label>
                                <input asp-for="DuracaoMinutos" type="number" class="form-control" placeholder="Ex: 120" />
                                <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label">
                                <i class="bi bi-card-text"></i> <strong>Description</strong>
                            </label>
                            <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva o filme..."></textarea>
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CapaUrl" class="form-label">
                                <i class="bi bi-image"></i> <strong>Cover URL</strong>
                            </label>
                            <input asp-for="CapaUrl" class="form-control mb-2" placeholder="https://exemplo.com/capa.jpg" id="capaUrlInput" />
                            <span asp-validation-for="CapaUrl" class="text-danger"></span>
                            <div class="d-flex gap-2 align-items-center mt-2">
                                <small class="form-text text-muted flex-grow-1">
                                    <i class="bi bi-info-circle"></i> Insira o URL completo de uma imagem
                                </small>
                                <a href="https://www.themoviedb.org/movie" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info">
                                    <i class="bi bi-search"></i> Procurar Capas (TMDb)
                                </a>
                                <a href="https://www.imdb.com/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning">
                                    <i class="bi bi-search"></i> Procurar no IMDb
                                </a>
                            </div>
                            <div id="imagePreview" class="mt-3" style="display: none;">
                                <small class="text-muted">Pré-visualização:</small><br>
                                <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-width: 200px; max-height: 300px;">
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Save Movie
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Elements
        const searchInput = document.getElementById('movieSearchInput');
        const searchButton = document.getElementById('searchButton');
        const loadingSpinner = document.getElementById('loadingSpinner');
        const searchResults = document.getElementById('movieSearchResults');
        const searchError = document.getElementById('searchError');
        const capaUrlInput = document.getElementById('capaUrlInput');
        const imagePreview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');

        // Image preview functionality
        capaUrlInput.addEventListener('input', function() {
            const url = this.value.trim();
            if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
                previewImg.src = url;
                imagePreview.style.display = 'block';
                
                // Hide preview if image fails to load
                previewImg.onerror = function() {
                    imagePreview.style.display = 'none';
                };
            } else {
                imagePreview.style.display = 'none';
            }
        });

        // Movie search functionality
        searchButton.addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        async function performSearch() {
            const query = searchInput.value.trim();
            if (!query) {
                showError('Please enter a movie title to search');
                return;
            }

            // Show loading, hide results and errors
            loadingSpinner.style.display = 'block';
            searchResults.innerHTML = '';
            searchError.style.display = 'none';

            try {
                const response = await fetch(`/Filmes/SearchMovies?query=${encodeURIComponent(query)}`, {
                    credentials: 'include'
                });
                const data = await response.json();

                loadingSpinner.style.display = 'none';

                if (!data.success) {
                    showError(data.error || 'No movies found');
                    return;
                }

                displayResults(data.movies);
            } catch (error) {
                loadingSpinner.style.display = 'none';
                showError('Error connecting to the server. Please try again.');
                console.error('Search error:', error);
            }
        }

        function displayResults(movies) {
            if (!movies || movies.length === 0) {
                showError('No movies found');
                return;
            }

            searchResults.innerHTML = '';
            
            movies.forEach(movie => {
                const col = document.createElement('div');
                col.className = 'col-md-3';
                
                const card = document.createElement('div');
                card.className = 'card h-100 shadow-sm movie-card';
                card.style.cursor = 'pointer';
                card.onclick = () => selectMovie(movie.imdbID);
                
                const posterUrl = movie.poster && movie.poster !== 'N/A' 
                    ? movie.poster 
                    : 'https://via.placeholder.com/300x450?text=No+Poster';
                
                card.innerHTML = `
                    <img src="${posterUrl}" class="card-img-top" alt="${movie.title}" 
                         style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title">${movie.title}</h6>
                        <p class="card-text text-muted small">
                            <i class="bi bi-calendar"></i> ${movie.year}
                        </p>
                        <button class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-check-circle"></i> Select
                        </button>
                    </div>
                `;
                
                col.appendChild(card);
                searchResults.appendChild(col);
            });
        }

        async function selectMovie(imdbId) {
            // Show loading
            loadingSpinner.style.display = 'block';
            searchResults.innerHTML = '';
            searchError.style.display = 'none';

            try {
                const response = await fetch(`/Filmes/GetMovieDetails?imdbId=${imdbId}`, {
                    credentials: 'include'
                });
                const data = await response.json();

                loadingSpinner.style.display = 'none';

                if (!data.success) {
                    showError(data.error || 'Error loading movie details. Please try again.');
                    return;
                }

                // Auto-fill form fields
                const movie = data.movie;
                document.querySelector('input[name="Titulo"]').value = movie.titulo || '';
                document.querySelector('input[name="Genero"]').value = movie.genero || '';
                document.querySelector('input[name="DuracaoMinutos"]').value = movie.duracaoMinutos || '';
                document.querySelector('textarea[name="Descricao"]').value = movie.descricao || '';
                capaUrlInput.value = movie.capaUrl || '';

                // Trigger image preview
                capaUrlInput.dispatchEvent(new Event('input'));

                // Show success message
                showSuccess('Movie details loaded successfully! Review and save.');

                // Scroll to form
                document.querySelector('input[name="Titulo"]').scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch (error) {
                loadingSpinner.style.display = 'none';
                showError('Error loading movie details. Please try again.');
                console.error('Details error:', error);
            }
        }

        function showError(message) {
            searchError.textContent = message;
            searchError.style.display = 'block';
        }

        function showSuccess(message) {
            searchError.className = 'alert alert-success';
            searchError.textContent = message;
            searchError.style.display = 'block';
            
            // Reset to error class after 5 seconds
            setTimeout(() => {
                searchError.className = 'alert alert-danger';
                searchError.style.display = 'none';
            }, 5000);
        }
    </script>
    
    <style>
        .movie-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
        }
    </style>
}

