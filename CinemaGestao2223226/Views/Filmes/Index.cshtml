@model IEnumerable<CinemaGestao2223226.Models.Filme>
@using CinemaGestao.Helpers

@{
    ViewData["Title"] = "Gestão de Filmes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-hero {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(2, 6, 23, 0.95) 50%, rgba(15, 23, 42, 0.9) 100%);
        border-radius: 24px;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .admin-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 60%;
        height: 200%;
        background: radial-gradient(ellipse, rgba(139, 92, 246, 0.1) 0%, transparent 60%);
        pointer-events: none;
    }

    .admin-hero h1 {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #ffffff 0%, #a78bfa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
    }

    .admin-hero .subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 1rem;
    }

    .admin-stats {
        display: flex;
        gap: 2rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .admin-stat {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .admin-stat i {
        font-size: 1.5rem;
        color: #a78bfa;
    }

    .admin-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
    }

    .admin-stat-label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        flex: 1;
        max-width: 400px;
    }

    .search-box input {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(139, 92, 246, 0.2);
        color: #ffffff;
        border-radius: 12px;
        padding: 0.75rem 1rem 0.75rem 3rem;
        width: 100%;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        border-color: #a78bfa;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
        outline: none;
    }

    .search-box i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.5);
    }

    .btn-add-movie {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: #ffffff;
        border: none;
        padding: 0.85rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-add-movie:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(34, 197, 94, 0.4);
        color: #ffffff;
    }

    .movies-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .movie-admin-card {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(2, 6, 23, 0.95) 100%);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(139, 92, 246, 0.1);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .movie-admin-card:hover {
        transform: translateY(-5px);
        border-color: rgba(139, 92, 246, 0.3);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(139, 92, 246, 0.1);
    }

    .movie-admin-header {
        display: flex;
        gap: 1rem;
        padding: 1.25rem;
        border-bottom: 1px solid rgba(139, 92, 246, 0.1);
    }

    .movie-admin-poster {
        width: 80px;
        height: 120px;
        border-radius: 10px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .movie-admin-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .movie-admin-poster-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .movie-admin-poster-placeholder i {
        font-size: 2rem;
        color: rgba(139, 92, 246, 0.4);
    }

    .movie-admin-info {
        flex: 1;
        min-width: 0;
    }

    .movie-admin-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.5rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-admin-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .movie-admin-badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
        border-radius: 50px;
        font-weight: 600;
    }

    .badge-genre {
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
    }

    .badge-duration {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
    }

    .badge-status-active {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .badge-status-soon {
        background: rgba(249, 115, 22, 0.2);
        color: #f97316;
    }

    .badge-status-archived {
        background: rgba(107, 114, 128, 0.2);
        color: #9ca3af;
    }

    .movie-admin-description {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .movie-admin-actions {
        display: flex;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        background: rgba(0, 0, 0, 0.2);
    }

    .btn-admin-action {
        flex: 1;
        padding: 0.65rem 0.75rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.3s ease;
        text-decoration: none;
        border: none;
    }

    .btn-edit {
        background: rgba(234, 179, 8, 0.2);
        color: #eab308;
        border: 1px solid rgba(234, 179, 8, 0.3);
    }

    .btn-edit:hover {
        background: rgba(234, 179, 8, 0.3);
        color: #eab308;
        transform: translateY(-2px);
    }

    .btn-view {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .btn-view:hover {
        background: rgba(56, 189, 248, 0.3);
        color: #38bdf8;
        transform: translateY(-2px);
    }

    .btn-delete {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.3);
        color: #ef4444;
        transform: translateY(-2px);
    }

    .empty-state-admin {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.9) 0%, rgba(2, 6, 23, 0.95) 100%);
        border-radius: 24px;
        padding: 4rem 2rem;
        text-align: center;
        border: 1px solid rgba(139, 92, 246, 0.1);
    }

    .empty-state-admin i {
        font-size: 4rem;
        color: rgba(139, 92, 246, 0.4);
        margin-bottom: 1.5rem;
    }

    .empty-state-admin h3 {
        color: #ffffff;
        margin-bottom: 0.75rem;
    }

    .empty-state-admin p {
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .admin-hero {
            padding: 1.5rem;
        }

        .admin-stats {
            gap: 1rem;
        }

        .admin-stat {
            padding: 0.75rem 1rem;
        }

        .action-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            max-width: none;
        }

        .movies-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid px-4 py-4 fade-in-up">
    <!-- Admin Hero Section -->
    <div class="admin-hero fade-in-down">
        <h1><i class="bi bi-film me-2"></i>Gestão de Filmes</h1>
        <p class="subtitle">Adicione, edite e gerencie todos os filmes do catálogo</p>
        
        <div class="admin-stats">
            <div class="admin-stat">
                <i class="bi bi-collection-play"></i>
                <div>
                    <div class="admin-stat-value">@Model.Count()</div>
                    <div class="admin-stat-label">Total de Filmes</div>
                </div>
            </div>
            <div class="admin-stat">
                <i class="bi bi-play-circle"></i>
                <div>
                    <div class="admin-stat-value">@Model.Count(f => f.Status == CinemaGestao2223226.Models.StatusFilme.EmCartaz)</div>
                    <div class="admin-stat-label">Em Cartaz</div>
                </div>
            </div>
            <div class="admin-stat">
                <i class="bi bi-clock-history"></i>
                <div>
                    <div class="admin-stat-value">@Model.Count(f => f.Status == CinemaGestao2223226.Models.StatusFilme.Brevemente)</div>
                    <div class="admin-stat-label">Brevemente</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="action-bar fade-in-up stagger-delay-1">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchMovies" placeholder="Pesquisar filmes...">
        </div>
        <a asp-action="Create" class="btn-add-movie">
            <i class="bi bi-plus-circle"></i>
            Adicionar Novo Filme
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state-admin scale-in">
            <i class="bi bi-film"></i>
            <h3>Nenhum Filme Registado</h3>
            <p>Comece por adicionar o primeiro filme ao catálogo do cinema utilizando o botão acima.</p>
        </div>
    }
    else
    {
        <div class="movies-grid" id="moviesGrid">
            @foreach (var item in Model)
            {
                var index = Model.ToList().IndexOf(item);
                var delay = (index % 4) * 0.08;
                
                <div class="movie-admin-card scale-in" 
                     data-title="@item.Titulo.ToLower()" 
                     style="animation-delay: @(delay)s">
                    <div class="movie-admin-header">
                        <div class="movie-admin-poster">
                            @if (!string.IsNullOrEmpty(item.CapaUrl))
                            {
                                <img src="@item.CapaUrl" alt="@item.Titulo" loading="lazy">
                            }
                            else
                            {
                                <div class="movie-admin-poster-placeholder">
                                    <i class="bi bi-film"></i>
                                </div>
                            }
                        </div>
                        <div class="movie-admin-info">
                            <h3 class="movie-admin-title" title="@item.Titulo">@item.Titulo</h3>
                            <div class="movie-admin-meta">
                                <span class="movie-admin-badge badge-genre">@item.Genero</span>
                                <span class="movie-admin-badge badge-duration">
                                    <i class="bi bi-clock me-1"></i>@DurationHelper.FormatDuration(item.DuracaoMinutos)
                                </span>
                                @if (item.Status == CinemaGestao2223226.Models.StatusFilme.EmCartaz)
                                {
                                    <span class="movie-admin-badge badge-status-active">Em Cartaz</span>
                                }
                                else if (item.Status == CinemaGestao2223226.Models.StatusFilme.Brevemente)
                                {
                                    <span class="movie-admin-badge badge-status-soon">Brevemente</span>
                                }
                                else
                                {
                                    <span class="movie-admin-badge badge-status-archived">Arquivado</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Descricao))
                            {
                                <p class="movie-admin-description">@item.Descricao</p>
                            }
                        </div>
                    </div>
                    <div class="movie-admin-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-admin-action btn-edit" title="Editar">
                            <i class="bi bi-pencil"></i>
                            Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-admin-action btn-view" title="Detalhes">
                            <i class="bi bi-eye"></i>
                            Ver
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-admin-action btn-delete" title="Eliminar">
                            <i class="bi bi-trash"></i>
                            Eliminar
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchMovies');
            const movieCards = document.querySelectorAll('.movie-admin-card');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                
                movieCards.forEach(card => {
                    const title = card.dataset.title;
                    if (title.includes(searchTerm)) {
                        card.style.display = '';
                        card.style.animation = 'scaleIn 0.3s ease forwards';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });

            console.log('Página de gestão de filmes inicializada');
        });
    </script>
}