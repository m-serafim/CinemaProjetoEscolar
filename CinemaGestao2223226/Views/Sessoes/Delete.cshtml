@model CinemaGestao2223226.Models.Sessao

@{
    ViewData["Title"] = "Eliminar Sessão";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Eliminar</h1>

<h3>Tem a certeza que pretende eliminar esta sessão?</h3>
<div>
    <h4>Sessão</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Filme
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Filme.Descricao)
        </dd>
        <dt class = "col-sm-2">
            Data e Hora
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataHora)
        </dd>
        <dt class = "col-sm-2">
            Sala
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sala)
        </dd>
        <dt class = "col-sm-2">
            Preço
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Preco)
        </dd>
        <dt class = "col-sm-2">
            Lugares Totais
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LugaresTotais)
        </dd>
        <dt class = "col-sm-2">
            Lugares Disponíveis
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LugaresDisponiveis)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar à Lista</a>
    </form>
</div>
