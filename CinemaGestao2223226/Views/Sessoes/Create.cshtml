@model CinemaGestao2223226.Models.Sessao

@{
    ViewData["Title"] = "Criar Sessão";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Fixed room configuration: 10 rows x 15 columns = 150 seats
    var lugaresTotais = 150;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4"><i class="bi bi-plus-circle"></i> Criar Nova Sessão</h1>

            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="FilmeId" class="form-label">
                                <i class="bi bi-film"></i> <strong>Filme</strong>
                            </label>
                            <select asp-for="FilmeId" class="form-select" asp-items="ViewBag.FilmeId">
                                <option value="">-- Selecione um Filme --</option>
                            </select>
                            <span asp-validation-for="FilmeId" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataHora" class="form-label">
                                    <i class="bi bi-calendar-event"></i> <strong>Data e Hora</strong>
                                </label>
                                <input asp-for="DataHora" type="datetime-local" class="form-control" />
                                <span asp-validation-for="DataHora" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Sala" class="form-label">
                                    <i class="bi bi-door-open"></i> <strong>Sala</strong>
                                </label>
                                <input asp-for="Sala" class="form-control" value="Sala Principal" readonly />
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> Sala única com capacidade para 150 lugares (10 filas x 15 colunas)
                                </small>
                                <span asp-validation-for="Sala" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Preco" class="form-label">
                                    <i class="bi bi-currency-euro"></i> <strong>Preço (€)</strong>
                                </label>
                                <input asp-for="Preco" type="text" class="form-control" placeholder="7.50" />
                                <span asp-validation-for="Preco" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-people"></i> <strong>Lugares Totais</strong>
                                </label>
                                <input type="text" class="form-control" value="@lugaresTotais" readonly />
                                <input asp-for="LugaresTotais" type="hidden" value="@lugaresTotais" />
                                <input asp-for="LugaresDisponiveis" type="hidden" value="@lugaresTotais" />
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> Capacidade fixa da sala
                                </small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Criar Sessão
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
            });
        }

        // Handle decimal separator for price
        const precoInput = document.querySelector('input[name="Preco"]');
        if (precoInput) {
            precoInput.addEventListener('blur', function() {
                // Normalize to use period as decimal separator
                this.value = this.value.replace(',', '.');
            });
        }
    </script>
}
