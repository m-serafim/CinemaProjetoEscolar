@model CinemaGestao2223226.Models.Sessao

@{
    ViewData["Title"] = "Detalhes da Sessão";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Detalhes</h1>

<div>
    <h4>Sessão</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Filme
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Filme.Descricao)
        </dd>
        <dt class = "col-sm-2">
            Data e Hora
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataHora)
        </dd>
        <dt class = "col-sm-2">
            Sala
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sala)
        </dd>
        <dt class = "col-sm-2">
            Preço
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Preco)
        </dd>
        <dt class = "col-sm-2">
            Lugares Totais
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LugaresTotais)
        </dd>
        <dt class = "col-sm-2">
            Lugares Disponíveis
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LugaresDisponiveis)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Voltar à Lista</a>
</div>
