@model IEnumerable<CinemaGestao.Models.Filme>
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<!-- Clean Modern Hero Section -->
<section class="modern-hero">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="bi bi-stars"></i>
                        <span>Premium Cinema Experience</span>
                    </div>
                    <h1 class="hero-title">
                        <span class="title-accent">Experience Cinema</span>
                        <span class="title-main">Like Never Before</span>
                    </h1>
                    <p class="hero-description">
                        Immerse yourself in the magic of movies at Nexor Cinema. 
                        State-of-the-art screens, premium sound, and unforgettable moments await you.
                    </p>
                    <div class="hero-cta">
                        <a asp-controller="Catalogo" asp-action="Index" class="btn-modern-primary">
                            <i class="bi bi-film"></i>
                            <span>Explore Movies</span>
                        </a>
                        <a href="#now-showing" class="btn-modern-secondary">
                            <i class="bi bi-play-circle"></i>
                            <span>Now Showing</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-visual">
                    <div id="heroMovieDisplay" class="hero-movie-display">
                        <!-- Movies will be loaded dynamically via JavaScript -->
                        <div class="movie-loading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Now Showing Section -->
<section id="now-showing" class="now-showing-section">
    <div class="container-fluid px-4 px-lg-5">
        <div class="section-header">
            <div class="section-badge">
                <i class="bi bi-film"></i>
                <span>Featured</span>
            </div>
            <h2 class="section-title">Now Showing</h2>
            <p class="section-subtitle">Discover the latest blockbusters and timeless classics</p>
        </div>
        
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var filme in Model.Take(3))
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="movie-card">
                            <div class="movie-poster">
                                @if (!string.IsNullOrEmpty(filme.CapaUrl))
                                {
                                    <img src="@filme.CapaUrl" alt="@filme.Titulo" onerror="this.src='/images/movies/placeholder.svg'" />
                                }
                                else
                                {
                                    <img src="~/images/movies/placeholder.svg" alt="@filme.Titulo" />
                                }
                            </div>
                            <div class="movie-info">
                                <h3 class="movie-title">@filme.Titulo</h3>
                                <div class="movie-meta">
                                    <span class="meta-badge meta-genre">
                                        <i class="bi bi-bookmark-fill"></i>
                                        @filme.Genero
                                    </span>
                                    @if (filme.DuracaoMinutos > 0)
                                    {
                                        <span class="meta-badge meta-duration">
                                            <i class="bi bi-clock-fill"></i>
                                            @filme.DuracaoMinutos min
                                        </span>
                                    }
                                </div>
                                <p class="movie-description">
                                    @(filme.Descricao.Length > 100 ? filme.Descricao.Substring(0, 100) + "..." : filme.Descricao)
                                </p>
                                <a asp-controller="Catalogo" asp-action="Details" asp-route-id="@filme.Id" class="btn-card">
                                    <span>View Details</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="no-movies">
                        <i class="bi bi-film"></i>
                        <h3>No Movies Available</h3>
                        <p>Check back soon for new releases!</p>
                    </div>
                </div>
            }
        </div>
        
        <div class="text-center mt-5">
            <a asp-controller="Catalogo" asp-action="Index" class="btn-view-all">
                <span>View All Movies</span>
                <i class="bi bi-arrow-right-circle-fill"></i>
            </a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container-fluid px-4 px-lg-5">
        <div class="section-header">
            <div class="section-badge">
                <i class="bi bi-star-fill"></i>
                <span>Why Choose Us</span>
            </div>
            <h2 class="section-title">Premium Cinema Features</h2>
            <p class="section-subtitle">Experience the best in movie entertainment technology</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-badge-4k"></i>
                    </div>
                    <h3 class="feature-title">4K Ultra HD</h3>
                    <p class="feature-description">
                        Crystal-clear picture quality with state-of-the-art projection technology
                    </p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-soundwave"></i>
                    </div>
                    <h3 class="feature-title">Immersive Sound</h3>
                    <p class="feature-description">
                        Dolby Atmos surround sound for the ultimate audio experience
                    </p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                    <h3 class="feature-title">Easy Booking</h3>
                    <p class="feature-description">
                        Seamless online reservation system with instant confirmation
                    </p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-bookmark-star"></i>
                    </div>
                    <h3 class="feature-title">Latest Releases</h3>
                    <p class="feature-description">
                        Get access to the newest blockbusters and exclusive premieres
                    </p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3 class="feature-title">Secure Platform</h3>
                    <p class="feature-description">
                        Built with ASP.NET Core Identity for safe and secure transactions
                    </p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h3 class="feature-title">Fast Performance</h3>
                    <p class="feature-description">
                        Powered by modern technology for lightning-fast browsing
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Enhanced movie rotation with CROSSFADE animation
        document.addEventListener('DOMContentLoaded', function() {
            const heroDisplay = document.getElementById('heroMovieDisplay');
            
            // Fetch movies data
            const movies = @Html.Raw(Json.Serialize(Model?.Take(5) ?? Enumerable.Empty<CinemaGestao.Models.Filme>()));
            
            if (movies && movies.length > 0) {
                let currentIndex = 0;
                let currentCard = null;
                
                function createMovieCard(movie) {
                    const imageUrl = movie.capaUrl || '/images/movies/placeholder.svg';
                    const card = document.createElement('a');
                    card.href = `/Catalogo/Details/${movie.id}`;
                    card.className = 'hero-movie-card';
                    card.innerHTML = `
                        <img src="${imageUrl}" alt="${movie.titulo}" onerror="this.src='/images/movies/placeholder.svg'">
                        <div class="hero-movie-title">${movie.titulo}</div>
                    `;
                    return card;
                }
                
                function displayMovie(index) {
                    const newCard = createMovieCard(movies[index]);
                    
                    if (currentCard) {
                        // Crossfade transition
                        newCard.style.opacity = '0';
                        heroDisplay.appendChild(newCard);
                        
                        // Trigger reflow
                        newCard.offsetHeight;
                        
                        // Start crossfade
                        currentCard.classList.add('crossfade-out');
                        newCard.classList.add('crossfade-in');
                        newCard.classList.add('active');
                        
                        // Clean up old card after transition
                        setTimeout(() => {
                            if (currentCard && currentCard.parentNode === heroDisplay) {
                                heroDisplay.removeChild(currentCard);
                            }
                            currentCard = newCard;
                        }, 600);
                    } else {
                        // First movie
                        newCard.classList.add('active');
                        heroDisplay.innerHTML = '';
                        heroDisplay.appendChild(newCard);
                        currentCard = newCard;
                    }
                }
                
                // Display first movie
                displayMovie(0);
                
                // Rotate every 5 seconds with crossfade
                setInterval(() => {
                    currentIndex = (currentIndex + 1) % movies.length;
                    displayMovie(currentIndex);
                }, 5000);
            } else {
                heroDisplay.innerHTML = '<div class="no-movies"><p>No movies available</p></div>';
            }
            
            console.log('✨ Nexor Cinema - Enhanced Crossfade Animation Loaded');
        });
    </script>
}
