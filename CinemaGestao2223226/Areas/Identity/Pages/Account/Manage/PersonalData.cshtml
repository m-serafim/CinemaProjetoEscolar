@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = "PersonalData";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .account-page {
        padding: 2rem 0;
    }
    
    .account-header {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }
    
    .account-header h1 {
        color: #fff;
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0;
    }
    
    .nav-account {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        padding: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .nav-account .nav-link {
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-bottom: 0.25rem;
        transition: all 0.3s ease;
    }
    
    .nav-account .nav-link:hover {
        background: rgba(56, 189, 248, 0.1);
        color: var(--accent-cyan);
    }
    
    .nav-account .nav-link.active {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, #0ea5e9 100%);
        color: #000;
        font-weight: 600;
    }
    
    .nav-account .nav-link i {
        margin-right: 0.5rem;
    }
    
    .card-account {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        margin-bottom: 1rem;
    }
    
    .card-account .card-header {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, #0ea5e9 100%);
        border-radius: 12px 12px 0 0;
        padding: 1rem 1.5rem;
    }
    
    .card-account .card-header h4,
    .card-account .card-header h5 {
        color: #000;
        margin: 0;
        font-weight: 600;
    }
    
    .card-account .card-body {
        padding: 1.5rem;
    }
    
    .card-account .card-body p {
        color: rgba(255, 255, 255, 0.8);
    }
    
    .card-account.danger .card-header {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }
    
    .btn-download {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, #0ea5e9 100%);
        border: none;
        color: #000;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .btn-download:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(56, 189, 248, 0.4);
        color: #000;
    }
    
    .btn-delete-account {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .btn-delete-account:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
        color: #fff;
    }
</style>

<div class="container account-page">
    <div class="account-header">
        <h1><i class="bi bi-person-circle me-2"></i>A Minha Conta</h1>
    </div>

    <div class="row">
        <div class="col-md-3">
            <nav class="nav-account">
                <nav class="nav flex-column">
                    <a class="nav-link" asp-page="./Index">
                        <i class="bi bi-person"></i> Perfil
                    </a>
                    <a class="nav-link" asp-page="./Email">
                        <i class="bi bi-envelope"></i> Email
                    </a>
                    <a class="nav-link" asp-page="./ChangePassword">
                        <i class="bi bi-key"></i> Palavra-passe
                    </a>
                    <a class="nav-link active" asp-page="./PersonalData">
                        <i class="bi bi-shield"></i> Dados
                    </a>
                    @if (!User.IsInRole("Administrador"))
                    {
                        <a class="nav-link" asp-page="./Transactions">
                            <i class="bi bi-receipt"></i> Transações
                        </a>
                    }
                </nav>
            </nav>
        </div>

        <div class="col-md-9">
            <div class="card card-account shadow">
                <div class="card-header">
                    <h4><i class="bi bi-info-circle me-2"></i>Os Seus Dados Pessoais</h4>
                </div>
                <div class="card-body">
                    <p>
                        A sua conta contém dados pessoais que nos forneceu. Esta página permite-lhe
                        transferir ou eliminar esses dados.
                    </p>
                    <p>
                        <strong style="color: #ef4444;">Eliminar estes dados irá remover permanentemente a sua conta e não poderá ser recuperado.</strong>
                    </p>
                </div>
            </div>

            <div class="card card-account shadow">
                <div class="card-header">
                    <h5><i class="bi bi-download me-2"></i>Transferir Dados</h5>
                </div>
                <div class="card-body">
                    <p>Pode transferir uma cópia dos seus dados pessoais em formato JSON.</p>
                    <form asp-page="./DownloadPersonalData" method="post">
                        <button class="btn btn-download" type="submit">
                            <i class="bi bi-file-earmark-arrow-down me-2"></i>Transferir Dados
                        </button>
                    </form>
                </div>
            </div>

            <div class="card card-account danger shadow">
                <div class="card-header">
                    <h5><i class="bi bi-trash me-2"></i>Eliminar Conta</h5>
                </div>
                <div class="card-body">
                    <p style="color: #ef4444;">
                        <strong>Atenção:</strong> Esta ação é irreversível. Todos os seus dados serão permanentemente eliminados.
                    </p>
                    <a asp-page="./DeletePersonalData" class="btn btn-delete-account">
                        <i class="bi bi-exclamation-triangle me-2"></i>Eliminar a Minha Conta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
